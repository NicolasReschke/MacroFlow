<Window x:Class="MacroFlow.App.RecordingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacroFlow.App"
        Title="Revisar grabación — MacroFlow" Width="820" Height="650" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <local:ActionKindLabelConverter x:Key="KindConverter" />
        <local:ActionValueLabelConverter x:Key="ValueConverter" />
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Grabación terminada" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
            <TextBlock Text="Revisá los tiempos. Después podés editar cada bloque con clic derecho."
                       Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
        </StackPanel>
        <DataGrid x:Name="ActionsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Background="#10151D" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}"
                  RowBackground="#10151D" AlternatingRowBackground="#151B25" GridLinesVisibility="Horizontal">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#202938"/><Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="10"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Acción" Binding="{Binding Kind, Converter={StaticResource KindConverter}}" Width="260" />
                <DataGridTextColumn Header="Tecla / botón" Binding="{Binding ., Converter={StaticResource ValueConverter}}" Width="*" />
                <DataGridTextColumn Header="Tiempo (ms)" Binding="{Binding DurationMs}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Descartar" Click="Discard_Click" />
            <Button Content="Agregar al final" Click="Append_Click" Padding="18,9" />
            <Button Content="Reemplazar secuencia" Click="Replace_Click" Background="{StaticResource PrimaryDark}" Padding="18,9" />
        </StackPanel>
    </Grid>
</Window>
