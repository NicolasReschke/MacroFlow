<Application x:Class="MacroFlow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0E1118" />
        <SolidColorBrush x:Key="PanelBackground" Color="#171C26" />
        <SolidColorBrush x:Key="PanelBorder" Color="#2A3342" />
        <SolidColorBrush x:Key="Primary" Color="#42D6C8" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#116D68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F7FB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9EABBD" />
        <SolidColorBrush x:Key="Danger" Color="#F56565" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10151D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#10151D" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#263141" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#3A4659" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,7" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Application.Resources>
</Application>
