<Window x:Class="MacroFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacroFlow.App"
        Title="MacroFlow" Height="850" Width="1550" MinHeight="720" MinWidth="1280"
        WindowStartupLocation="CenterScreen" Icon="Assets/app-icon.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <local:ActionKindLabelConverter x:Key="ActionKindLabelConverter" />
        <local:ActionValueLabelConverter x:Key="ActionValueLabelConverter" />
    </Window.Resources>
    <Grid Margin="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MacroFlow" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Creá una secuencia y decidí exactamente cuándo debe pausarse."
                           Foreground="{StaticResource TextSecondary}" FontSize="14" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#6B7280" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="DETENIDO" FontWeight="Bold" />
                        <TextBlock x:Name="PauseReasonsText" Text="Sin pausas activas" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="CapturePanel" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,14"
                Background="#2A2414" BorderBrush="#B7791F" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="CaptureText" VerticalAlignment="Center" FontWeight="SemiBold"
                           Text="Presioná ahora la tecla que querés usar…" />
                <Button Grid.Column="1" Content="Cancelar captura" Click="CancelCapture_Click" Padding="12,5" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="475" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. PERFIL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary}" />
                        <TextBlock Text="Poné un nombre, guardalo y luego podrás volver a cargarlo."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Label Content="Nombre" />
                        <TextBox x:Name="ProfileNameBox" Text="Throne and Liberty" />
                        <Label Content="Perfiles guardados" />
                        <ComboBox x:Name="ProfilesCombo" SelectionChanged="ProfilesCombo_SelectionChanged" />
                        <WrapPanel Margin="-4,0,0,6">
                            <Button Content="Guardar perfil" Click="SaveProfile_Click" />
                            <Button Content="Actualizar lista" Click="RefreshProfiles_Click" />
                            <Button Content="Importar JSON" Click="ImportProfile_Click" />
                            <Button Content="Exportar JSON" Click="ExportProfile_Click" />
                            <Button Content="Abrir carpeta" Click="OpenProfilesFolder_Click" />
                        </WrapPanel>
                        <Separator Background="{StaticResource PanelBorder}" Margin="0,10,0,16" />

                        <TextBlock Text="2. TECLAS DE CONTROL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary}" />
                        <TextBlock Text="No escribas el nombre: usá Capturar y presioná la tecla física."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <Label Content="Iniciar o detener la secuencia" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ToggleKeyBox" IsReadOnly="True" IsTabStop="False" />
                            <Button Grid.Column="1" Content="Capturar" Tag="Toggle" Click="CaptureKey_Click" Margin="8,4,0,10" />
                            <Button Grid.Column="2" Content="Mostrar teclado virtual" Tag="Toggle" Click="ShowVirtualKeyboard_Click" Margin="8,4,0,10" />
                        </Grid>
                        <Label Content="Detener todo inmediatamente" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="EmergencyKeyBox" IsReadOnly="True" IsTabStop="False" />
                            <Button Grid.Column="1" Content="Capturar" Tag="Emergency" Click="CaptureKey_Click" Margin="8,4,0,10" />
                            <Button Grid.Column="2" Content="Mostrar teclado virtual" Tag="Emergency" Click="ShowVirtualKeyboard_Click" Margin="8,4,0,10" />
                        </Grid>
                        <Label Content="Pausar mientras mantengo la tecla (parry)" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="HoldPauseKeyBox" IsReadOnly="True" IsTabStop="False" />
                            <Button Grid.Column="1" Content="Capturar" Tag="HoldPause" Click="CaptureKey_Click" Margin="8,4,0,10" />
                            <Button Grid.Column="2" Content="Mostrar teclado virtual" Tag="HoldPause" Click="ShowVirtualKeyboard_Click" Margin="8,4,0,10" />
                        </Grid>
                        <Label Content="Alternar pausa al entrar/salir de morph" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="MorphKeyBox" IsReadOnly="True" IsTabStop="False" />
                            <Button Grid.Column="1" Content="Capturar" Tag="Morph" Click="CaptureKey_Click" Margin="8,4,0,10" />
                            <Button Grid.Column="2" Content="Mostrar teclado virtual" Tag="Morph" Click="ShowVirtualKeyboard_Click" Margin="8,4,0,10" />
                        </Grid>
                        <Label Content="Esperar antes de reanudar (milisegundos)" />
                        <TextBox x:Name="ResumeDelayBox" Text="150" />
                        <CheckBox x:Name="RepeatCheck" Content="Volver a empezar al terminar la secuencia" IsChecked="True" />
                        <CheckBox x:Name="RestrictProcessCheck" Content="Funcionar sólo si el juego está en primer plano" />
                        <Label Content="Proceso del juego (sin .exe)" Margin="0,6,0,0" />
                        <TextBox x:Name="TargetProcessBox" Text="TL" />

                        <Separator Background="{StaticResource PanelBorder}" Margin="0,10,0,16" />
                        <TextBlock Text="3. GRABADORA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary}" />
                        <TextBlock Text="Usá esta combinación dentro del juego para iniciar y finalizar la grabación."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Label Content="Combinación para grabar" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="RecorderHotkeyBox" IsReadOnly="True" IsTabStop="False" />
                            <Button Grid.Column="1" Content="Capturar combinación" Tag="Recorder" Click="CaptureKey_Click" Margin="8,4,0,10" />
                        </Grid>
                        <TextBlock Text="Predeterminado: Ctrl + F8. La combinación de inicio/fin no se agrega a la grabación."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Text="Para botones especiales del G502, asignales F13–F24 en G Hub y capturalos acá."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="4. SECUENCIA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Primary}" />
                        <TextBlock Text="Cada bloque se ejecuta de izquierda a derecha. Seleccioná uno para moverlo o eliminarlo."
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#0B0F15" BorderBrush="{StaticResource PanelBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="4,0,4,10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="#8F1438" VerticalAlignment="Center" />
                                    <TextBlock Text="  Tecla" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <Ellipse Width="9" Height="9" Fill="#24536B" Margin="18,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="  Espera" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <Ellipse Width="9" Height="9" Fill="#54377A" Margin="18,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="  Mouse" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" Text="La secuencia continúa de izquierda a derecha →"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Grid>

                            <ListBox x:Name="ActionsGrid" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}" SelectionMode="Single"
                                     AllowDrop="True" PreviewMouseLeftButtonDown="ActionsGrid_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="ActionsGrid_PreviewMouseMove" DragOver="ActionsGrid_DragOver"
                                     Drop="ActionsGrid_Drop"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="4,4,2,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <EventSetter Event="MouseRightButtonUp" Handler="ActionItem_RightClick" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="SelectionBorder" Background="Transparent" BorderBrush="Transparent"
                                                            BorderThickness="2" CornerRadius="9" Padding="7">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="SelectionBorder" Property="Background" Value="#17212D" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource Primary}" />
                                                            <Setter TargetName="SelectionBorder" Property="Background" Value="#173134" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="TemplateRoot" Width="194" Height="76">
                                            <Grid x:Name="ActionContent" Width="194">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62"/><ColumnDefinition Width="112"/><ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ActionTile" Width="58" Height="58" CornerRadius="6"
                                                        Background="#8F1438" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource ActionValueLabelConverter}}"
                                                               Foreground="White" FontSize="15" FontWeight="Bold"
                                                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Kind, Converter={StaticResource ActionKindLabelConverter}}"
                                                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding DurationMs}" FontSize="18" FontWeight="SemiBold" />
                                                        <TextBlock Text=" ms" FontSize="12" VerticalAlignment="Bottom" Margin="1,0,0,2" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="→" FontSize="18" Foreground="#667386"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                            <Button x:Name="InlineAddButton" Content="＋" Width="58" Height="58" Visibility="Collapsed"
                                                    FontSize="26" FontWeight="Light" ToolTip="Agregar una acción"
                                                    Background="#3A3F47" Click="AddAction_Click" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Delay">
                                                <Setter TargetName="ActionTile" Property="Background" Value="#24536B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="MouseClick">
                                                <Setter TargetName="ActionTile" Property="Background" Value="#54377A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="KeyDown">
                                                <Setter TargetName="ActionTile" Property="BorderBrush" Value="#F59E0B" />
                                                <Setter TargetName="ActionTile" Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="KeyUp">
                                                <Setter TargetName="ActionTile" Property="BorderBrush" Value="#60A5FA" />
                                                <Setter TargetName="ActionTile" Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAdd}" Value="True">
                                                <Setter TargetName="TemplateRoot" Property="Width" Value="76" />
                                                <Setter TargetName="ActionContent" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="InlineAddButton" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="↑ Subir" Click="MoveUp_Click" /><Button Content="↓ Bajar" Click="MoveDown_Click" />
                            <Button Content="Eliminar tecla" Foreground="{StaticResource Danger}" Click="DeleteAction_Click" />
                            <Button Content="Borrar secuencia" Foreground="{StaticResource Danger}" Click="ClearActions_Click" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                                   Text="Para Ctrl + tecla: mantener Ctrl → pulsar tecla → soltar Ctrl." />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="3" Text="Listo para configurar."
                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,18,0,0" />
    </Grid>
</Window>
