<Window x:Class="MacroFlow.App.MacroActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar acción — MacroFlow" Width="650" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app-icon.png"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="HeadingText" Text="Agregar a la secuencia" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Configurá una acción. Podrás moverla arrastrándola y editarla con clic derecho."
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="10" Padding="18">
            <StackPanel>
                <Label Content="¿Qué debe hacer?" />
                <ComboBox x:Name="KindCombo" SelectedIndex="0" SelectionChanged="KindCombo_SelectionChanged">
                    <ComboBoxItem Content="Pulsar y soltar una tecla" Tag="KeyPress" />
                    <ComboBoxItem Content="Mantener una tecla presionada" Tag="KeyDown" />
                    <ComboBoxItem Content="Soltar una tecla mantenida" Tag="KeyUp" />
                    <ComboBoxItem Content="Esperar" Tag="Delay" />
                    <ComboBoxItem Content="Hacer clic con el mouse" Tag="MouseClick" />
                </ComboBox>

                <Grid x:Name="KeyPanel">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Label Content="Tecla" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyBox" IsReadOnly="True" IsTabStop="False" />
                        <Button x:Name="CaptureButton" Grid.Column="1" Content="Capturar tecla" Click="Capture_Click" Margin="8,4,0,10" />
                        <Button Grid.Column="2" Content="Mostrar teclado virtual" Click="VirtualKeyboard_Click" Margin="8,4,0,10" />
                    </Grid>
                </Grid>

                <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                    <Label Content="Botón del mouse" />
                    <ComboBox x:Name="MouseCombo" SelectedIndex="0">
                        <ComboBoxItem Content="Izquierdo" Tag="left" />
                        <ComboBoxItem Content="Derecho" Tag="right" />
                        <ComboBoxItem Content="Central" Tag="middle" />
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="NoValueText" Text="Esta acción no necesita una tecla."
                           Foreground="{StaticResource TextSecondary}" Visibility="Collapsed" Margin="0,5,0,15" />

                <Label x:Name="DurationLabel" Content="Tiempo presionada (ms)" />
                <TextBox x:Name="DurationBox" Text="50" />
                <TextBlock x:Name="HelpText" Text="La tecla se presiona y se suelta automáticamente."
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                <Border x:Name="CaptureNotice" Visibility="Collapsed" Background="#2A2414" BorderBrush="#B7791F"
                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="Captura activa: presioná ahora la tecla física que querés usar." FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="Cancel_Click" Padding="18,9" />
            <Button x:Name="SaveButton" Content="Agregar" Click="Save_Click"
                    Background="{StaticResource PrimaryDark}" Padding="22,9" />
        </StackPanel>
    </Grid>
</Window>
